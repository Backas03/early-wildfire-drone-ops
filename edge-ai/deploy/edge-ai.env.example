# 엣지 AI 자동 실행 설정 → ~/.config/edge-ai.env
# 고친 뒤 적용: systemctl --user restart edge-ai
#
# --mqtt-host: 서버 PC 이름(공유기가 붙여 준 <PC 이름>.lan)이나 IP
# 모델·영상 경로는 저장소 폴더 기준

# 실제 비행: 카메라 모듈 3, 화면 없이
EDGE_ARGS=--source picamera --model models/fire_n_ncnn_model --mqtt-host com12-45.lan

# 책상 시험: 영상 파일 + 탐지 창(VNC로 보기)
# EDGE_ARGS=--source video:@HOME@/videos/sample.mp4 --model models/fire_n_ncnn_model --mqtt-host com12-45.lan --show

# --show(탐지 창)에 필요한 바탕화면 정보. 화면이 아직 안 떴으면 프로그램이 죽고 5초 뒤 다시 켜진다
DISPLAY=:0
XAUTHORITY=@HOME@/.Xauthority
# pip OpenCV의 Qt는 X11(xcb)만 있어서 바로 xcb로 (안 쓰면 wayland를 찾다가 경고)
QT_QPA_PLATFORM=xcb
